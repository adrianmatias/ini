"""Behaviour of {{project}} at its public surface: the run script and what it drives."""

import pytest

from {{package}}.cli.loss import main


@pytest.mark.parametrize(
    ("direction", "measured", "code"),
    [("up", 0.9, 0), ("up", 0.7, 1), ("down", 0.7, 0), ("down", 0.9, 1)],
)
def test_the_loss_closes_only_when_the_target_is_met(
    tmp_path, capsys, direction, measured, code
) -> None:
    target = tmp_path / "target.json"
    target.write_text(f'{{"metric": "precision", "threshold": 0.8, "direction": "{direction}"}}')
    assert main(["--target", str(target), "--measured", str(measured)]) == code
    assert capsys.readouterr().out.startswith("precision: loss ")
